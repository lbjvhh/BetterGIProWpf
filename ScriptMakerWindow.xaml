<Window x:Class="BetterGIProWpf.ScriptMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛠 脚本工坊 · 视频 → 脚本制作 → 执行" Height="720" Width="1120"
        Background="{DynamicResource BgMain}" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部：类型 + 模板 -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="脚本工坊" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                <TextBlock Text="选择脚本类型 → 载入模板或手动编辑 → 生成 / 测试执行 / 保存到 User / 上传云端" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="脚本类型" Width="72" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="TypeCombo" Width="180" SelectionChanged="TypeCombo_SelectionChanged">
                        <ComboBoxItem Content="JS 脚本（调度器）" Tag="js"/>
                        <ComboBoxItem Content="战斗策略（AutoFight）" Tag="fight"/>
                        <ComboBoxItem Content="路径追踪（AutoPathing）" Tag="pathing"/>
                        <ComboBoxItem Content="键鼠脚本（KeyMouse）" Tag="keymouse"/>
                        <ComboBoxItem Content="调度器配置组（ScriptGroup）" Tag="group"/>
                    </ComboBox>
                    <TextBlock Text="内置模板" Width="72" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="TemplateCombo" Width="220" SelectionChanged="TemplateCombo_SelectionChanged"/>
                    <Button Content="载入模板" Width="90" Margin="8,0,0,0" Click="LoadTemplate_Click"/>
                    <Button Content="清空编辑区" Width="90" Margin="8,0,0,0" Click="ClearRows_Click"/>
                    <TextBlock Text="目标目录" Width="70" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="UserRootBox" Width="240" VerticalContentAlignment="Center" Text="C:\BetterGI\User"
                             ToolTip="BetterGI User 目录（保存/上传的落点；不存在时回退到程序目录 User）"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中左：步骤编辑表格 -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="GridTitle" Text="编辑步骤" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="2,0,0,8"/>
                    <DataGrid x:Name="StepGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                              Background="Transparent" RowHeaderWidth="0" HeadersVisibility="Column"
                              BorderThickness="0" GridLinesVisibility="None" Foreground="{DynamicResource TextMain}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="列1" Binding="{Binding C1}" Width="*"/>
                            <DataGridTextColumn Header="列2" Binding="{Binding C2}" Width="*"/>
                            <DataGridTextColumn Header="列3" Binding="{Binding C3}" Width="*"/>
                            <DataGridTextColumn Header="列4" Binding="{Binding C4}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,8,0,0">
                <Button Content="＋ 添加行" Width="90" Click="AddRow_Click"/>
                <Button Content="－ 删除选中" Width="90" Margin="8,0,0,0" Click="DelRow_Click"/>
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </Grid>

        <!-- 中右：参数 + 动作 -->
        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="脚本参数" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,10"/>
                    <TextBlock Text="脚本名称" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="NameBox" Margin="0,2,0,8"/>
                    <TextBlock Text="作者" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="AuthorBox" Margin="0,2,0,8" Text="BetterGI Pro 用户"/>
                    <TextBlock Text="版本" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="VersionBox" Margin="0,2,0,8" Text="1.0.0"/>
                    <TextBlock Text="说明（写入 manifest / 头部注释）" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="DescBox" Margin="0,2,0,8" TextWrapping="Wrap" Height="48" AcceptsReturn="True"
                             Text="由脚本工坊生成"/>
                    <TextBlock Text="视频来源（可选，JS 脚本会写入 manifest）" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="VideoBox" Margin="0,2,0,8" TextWrapping="Wrap" Height="40"
                             ToolTip="攻略视频路径或 URL，用于溯源与知识库关联"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="⚙ 生成脚本" Height="34" Click="Generate_Click" Background="#2e7d32" Foreground="White"/>
                    <Button Content="▶ 测试执行（经 bridge 注入）" Height="30" Margin="0,8,0,0" Click="TestRun_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 保存到 User" Height="30" Width="150" Click="SaveToUser_Click"/>
                        <Button Content="☁ 上传云端" Height="30" Width="120" Margin="8,0,0,0" Click="Upload_Click"/>
                    </StackPanel>
                    <TextBlock Text="GitHub PAT（上传用）" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,2"/>
                    <PasswordBox x:Name="PatBox"/>
                    <TextBlock Text="分类" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,2"/>
                    <ComboBox x:Name="UploadCatCombo" SelectedIndex="0">
                        <ComboBoxItem Content="combat（战斗）" Tag="combat"/>
                        <ComboBoxItem Content="js（脚本）" Tag="js"/>
                        <ComboBoxItem Content="pathing（路径）" Tag="pathing"/>
                        <ComboBoxItem Content="tcg（七圣召唤）" Tag="tcg"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="（视频识别 → 脚本自动生成的完整链路见「识别层」页；此处支持手动制作与模板快速起步）"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="10"
                           DockPanel.Dock="Bottom" Margin="0,6,0,0"/>
            </DockPanel>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="日志" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="2,0,0,6"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMuted}"
                         FontFamily="Consolas" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
