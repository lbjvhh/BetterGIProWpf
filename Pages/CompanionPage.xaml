<Page x:Class="BetterGIProWpf.Pages.CompanionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="AI 队友" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ComboBox x:Name="ModeCombo" Width="140" Margin="0,0,8,0" SelectionChanged="ModeCombo_SelectionChanged">
                <ComboBoxItem Content="跟随模式" Tag="follow" IsSelected="True"/>
                <ComboBoxItem Content="自主模式" Tag="autonomous"/>
            </ComboBox>
            <TextBlock Text="成功率:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock x:Name="RateLabel" Text="0%" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="接管控制" Click="Takeover_Click" Width="100" Height="28" Margin="0,0,8,0"/>
            <Button x:Name="VoiceBtn" Content="🎤 语音指令" Click="VoiceDemo_Click" Width="120" Height="28"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="CompanionLog" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="CmdBox" Width="400" Height="28" VerticalContentAlignment="Center"
                         Text="帮我打这个怪" Margin="0,0,8,0"/>
                <Button Content="发送指令" Click="SendCmd_Click" Width="100" Height="28" Margin="0,0,16,0"/>
                <TextBox x:Name="QaBox" Width="240" Height="28" VerticalContentAlignment="Center"
                         Text="我现在在哪？" Margin="0,0,8,0"/>
                <Button Content="问游戏状态" Click="AskQa_Click" Width="100" Height="28"/>
            </StackPanel>
            <TextBlock x:Name="QaStatus" Grid.Row="2" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
        </Grid>
    </Grid>
</Page>
