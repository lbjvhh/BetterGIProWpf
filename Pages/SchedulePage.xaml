<Page x:Class="BetterGIProWpf.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="定时调度" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="cron 表达式：分 时 日 月 周（* 表示任意；*/n 表示每 n）。例如 30 3 * * * = 每天 03:30。"
                       Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <ListBox x:Name="JobList" Padding="8" BorderThickness="0"/>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="名称" VerticalAlignment="Center" Width="50"/><TextBox x:Name="JobName" Width="160" Height="28" Margin="0,0,12,0"/>
                    <TextBlock Text="cron" VerticalAlignment="Center" Width="40"/><TextBox x:Name="JobCron" Width="160" Height="28" Margin="0,0,12,0" Text="0 6 * * *"/>
                    <TextBlock Text="动作" VerticalAlignment="Center" Width="40"/>
                    <ComboBox x:Name="JobAction" Width="180">
                        <ComboBoxItem Content="启动游戏" Tag="launch_genshin"/>
                        <ComboBoxItem Content="后台截图" Tag="capture"/>
                        <ComboBoxItem Content="执行操作序列" Tag="run_steps"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="添加任务" Width="90" Margin="0,0,8,0" Click="Add_Click"/>
                    <Button Content="删除选中" Width="90" Click="Delete_Click"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
