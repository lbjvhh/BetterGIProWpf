<Page x:Class="BetterGIProWpf.Pages.TriggersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="640">
            <TextBlock Text="实时触发的自动化任务设置" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <CheckBox x:Name="PickupChk" Content="自动拾取 —— 按名单模式自动按 F 交互" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StoryChk" Content="自动剧情 —— 快进文本、自动选选项、自动提交物品" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="InviteChk" Content="自动邀约 —— 自动选择邀约选项" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="FishChk" Content="半自动钓鱼 —— 手动抛竿，自动提竿" Margin="0,0,0,8"/>
                    <CheckBox x:Name="HealChk" Content="自动吃药 —— 血线低时用便携营养袋回复" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="TeleportChk" Content="快速传送 —— 点大地图传送点时自动传送" IsChecked="True" Margin="0,0,0,12"/>
                    <Button Content="保存开关" Width="100" Click="Save_Click"/>
                    <TextBlock x:Name="Msg" Margin="0,10,0,0" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
