<Page x:Class="BetterGIProWpf.Pages.AgentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="智能代理 · 双轨执行" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="执行模式" Width="90" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ModeCombo" Width="220" SelectedIndex="2">
                        <ComboBoxItem Content="主轨（任务执行）" Tag="task"/>
                        <ComboBoxItem Content="辅轨（端到端代理）" Tag="e2e"/>
                        <ComboBoxItem Content="混合（置信度回退）" Tag="hybrid" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="置信度阈值" Width="90" VerticalAlignment="Center"/>
                    <Slider x:Name="ThreshSlider" Minimum="0.1" Maximum="0.9" Value="0.6" Width="200"/>
                    <TextBlock x:Name="ThreshLabel" Text="0.60" Width="60" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="▶ 启动辅轨循环" Width="130" Margin="0,0,8,0" Click="RunBtn_Click"/>
                    <Button x:Name="StopBtn" Content="■ 停止" Width="80" IsEnabled="False" Click="StopBtn_Click"/>
                    <TextBlock x:Name="ModeStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <TextBlock Text="辅轨接入说明：当前为模拟代理演示回退机制。真实接入时把 IEndToEndAgent 替换为 NitroGen 类模型的 HTTP/gRPC 客户端。"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="AgentLog" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     Background="White" BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Page>
