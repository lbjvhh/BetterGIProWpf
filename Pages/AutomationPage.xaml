<Page x:Class="BetterGIProWpf.Pages.AutomationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="自动化编排" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="定时任务（cron 表达式，支持多组互不干扰）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="名称" Width="50" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameBox" Width="140" Height="28" Text="每日解析" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="cron" Width="40" VerticalAlignment="Center"/>
                        <TextBox x:Name="CronBox" Width="130" Height="28" Text="0 3 * * *" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="动作" Width="40" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ActionCombo" Width="120">
                            <ComboBoxItem Content="执行任务" Tag="run-tasks" IsSelected="True"/>
                            <ComboBoxItem Content="解析视频" Tag="parse-video"/>
                            <ComboBoxItem Content="睡眠" Tag="system-sleep"/>
                            <ComboBoxItem Content="唤醒" Tag="system-wake"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋ 添加" Width="80" Margin="0,0,8,0" Click="AddTask_Click"/>
                        <Button Content="刷新下次执行" Width="120" Margin="0,0,8,0" Click="RefreshTasks_Click"/>
                    </StackPanel>
                    <ListBox x:Name="TaskList" Height="120" Margin="0,10,0,0" Background="White" BorderBrush="{DynamicResource Border}"/>
                    <TextBlock x:Name="SchedMsg" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="电源管理（睡眠/唤醒）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="立即睡眠" Width="100" Margin="0,0,8,0" Click="SleepBtn_Click"/>
                        <Button Content="设置 5 分钟后唤醒" Width="140" Margin="0,0,8,0" Click="WakeBtn_Click"/>
                        <Button Content="清除唤醒计时器" Width="120" Click="ClearWake_Click"/>
                    </StackPanel>
                    <TextBlock Text="注意：睡眠会挂起整机，请确认任务已保存。唤醒使用 powercfg /waketimer（RTC 唤醒）。"
                               Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="模块管理（自动重启 + 集中日志）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="启动全部模块" Width="120" Margin="0,0,8,0" Click="ModulesStart_Click"/>
                        <Button Content="停止全部模块" Width="120" Margin="0,0,8,0" Click="ModulesStop_Click"/>
                        <TextBlock x:Name="ModuleStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBox x:Name="ModuleLog" Height="110" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Background="White" BorderBrush="{DynamicResource Border}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="后台模式" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="BgModeChk" Content="游戏画面捕获不依赖窗口焦点（PrintWindow 捕获，视频参考与游戏捕获互不干扰）" Margin="0,0,0,8"/>
                    <TextBlock Text="说明：输入模拟为全局键鼠（SendInput），后台执行时请避免同时操作前台窗口；对独占全屏 DX 游戏建议使用捕获服务扩展。"
                               Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
