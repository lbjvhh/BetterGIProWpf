<Page x:Class="BetterGIProWpf.Pages.KnowledgePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="攻略知识库 · 语义检索 · 资源/物品/翻译" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>

        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="语义检索" Width="90" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Width="300" VerticalContentAlignment="Center" ToolTip="例如：风起地锚点 / 北风狼王"/>
                    <Button Content="检索" Width="70" Margin="8,0,0,0" Click="Search_Click"/>
                    <TextBlock Text="  筛选地点" Width="80" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="LocBox" Width="100" VerticalContentAlignment="Center"/>
                    <Button Content="转路径JSON" Width="110" Margin="8,0,0,0" Click="ToPath_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="添加示例条目" Width="120" Click="AddDemo_Click"/>
                    <Button Content="导出 JSON" Width="100" Margin="8,0,0,0" Click="Export_Click"/>
                    <TextBlock Text="  资源管理：水晶块目标" Width="150" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="TargetBox" Width="80" VerticalContentAlignment="Center" Text="1000"/>
                    <Button Content="生成建议" Width="90" Margin="8,0,0,0" Click="Resource_Click"/>
                    <TextBlock Text="  翻译" Width="50" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="TransBox" Width="140" VerticalContentAlignment="Center" Text="Statue of The Seven"/>
                    <Button Content="译" Width="40" Margin="8,0,0,0" Click="Translate_Click"/>
                </StackPanel>
                <!-- P1-9：多模态游戏状态问答 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="问答" Width="90" VerticalAlignment="Center"/>
                    <TextBox x:Name="QaBox" Width="380" VerticalContentAlignment="Center"
                             ToolTip="例如：我现在在哪？/这是什么？/有多少血？/怎么过去？"/>
                    <Button Content="问" Width="70" Margin="8,0,0,0" Click="Qa_Click"/>
                    <TextBlock x:Name="QaOcrHint" Text="" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="KnowledgeLog" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     Background="White" BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Page>
