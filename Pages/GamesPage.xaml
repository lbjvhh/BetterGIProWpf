<Page x:Class="BetterGIProWpf.Pages.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="游戏管理" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="选择游戏" Width="80" VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/>
                        <ComboBox x:Name="GameCombo" Width="220" SelectedIndex="0">
                            <ComboBoxItem Tag="genshin" Content="原神" IsSelected="True"/>
                            <ComboBoxItem Tag="hsr" Content="崩坏：星穹铁道"/>
                            <ComboBoxItem Tag="wuthering" Content="鸣潮"/>
                            <ComboBoxItem Tag="zzz" Content="绝区零"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="ExeBox" Width="440" Height="30" VerticalContentAlignment="Center"
                                 Margin="0,0,8,0" IsEnabled="True"/>
                        <Button Content="浏览..." Width="80" Click="BrowseBtn_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DetectBtn" Content="🔍 自动检测" Width="100" Margin="0,0,8,0" Click="DetectBtn_Click"/>
                        <Button x:Name="LaunchBtn" Content="🚀 启动游戏" Width="100" Click="LaunchBtn_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="自动检测会扫描注册表卸载项与常见安装目录；启动后最多等待 60s 查找游戏窗口。"
                       Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
