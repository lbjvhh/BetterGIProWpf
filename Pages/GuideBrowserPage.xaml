<Page x:Class="BetterGIProWpf.Pages.GuideBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                     Text="https://www.bilibili.com/video/BV1xx411c7mD"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="8,0,0,0">
                <Button x:Name="OpenBtn" Content="打开" Width="60" Height="28" Margin="0,0,4,0" Click="OpenBtn_Click"/>
                <Button x:Name="PlayBtn" Content="播放" Width="60" Height="28" Margin="0,0,4,0" Click="PlayBtn_Click"/>
                <Button x:Name="PauseBtn" Content="暂停" Width="60" Height="28" Margin="0,0,4,0" Click="PauseBtn_Click"/>
                <TextBox x:Name="SeekBox" Width="60" Height="28" Text="30"/>
                <Button x:Name="SeekBtn" Content="跳转" Width="60" Height="28" Margin="4,0,4,0" Click="SeekBtn_Click"/>
                <Button x:Name="CaptureBtn" Content="抓帧" Width="60" Height="28" Margin="0,0,4,0" Click="CaptureBtn_Click"/>
                <Button x:Name="AnalyzeBtn" Content="识别分析" Width="90" Height="28" Click="AnalyzeBtn_Click"/>
            </StackPanel>
        </Grid>
        <WebView2 x:Name="Web" Grid.Row="1" Margin="12,0"/>
        <StackPanel Grid.Row="2" Margin="12,8">
            <TextBlock x:Name="StatusText" Text="WebView2 初始化中…" Foreground="{DynamicResource TextMuted}"/>
            <TextBox x:Name="ResultText" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6"/>
            <Button x:Name="GoExecuteBtn" Content="前往执行页 →" HorizontalAlignment="Right" Width="140" Height="28" Click="GoExecuteBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
