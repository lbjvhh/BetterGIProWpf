<Page x:Class="BetterGIProWpf.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <Border Background="#E7F2EA" CornerRadius="12" Padding="28">
                <StackPanel>
                    <TextBlock Text="BetterGI Pro · WPF" FontSize="26" FontWeight="Bold" Foreground="#1F6B4A"/>
                    <TextBlock Text="基于 .NET 8 + WPF + WebView2 的游戏助手" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="核心能力" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="• 内置攻略浏览器（WebView2）：打开攻略网页，逐帧截图 → 多模态 AI 识别成操作步骤"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            <TextBlock Text="• 游戏自动启动：注册表/常见目录自动探测 + 等待主窗口（60s）"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="• AI 服务：本地模型（NitroGen/PaddleOCR/Whisper/YOLO），离线运行"
                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Button Content="前往「游戏管理」启动游戏" Width="260" Height="36" Margin="0,20,0,0" Click="GotoGames_Click"/>
            <Button Content="前往「攻略浏览器」识别网页视频" Width="260" Height="36" Margin="0,10,0,0" Click="GotoBrowser_Click"/>
        </StackPanel>
    </Grid>
</Page>
