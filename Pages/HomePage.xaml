<Page x:Class="BetterGIProWpf.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BgMain}">
  <Grid Margin="24"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
    <Border Background="#E7F2EA" CornerRadius="12" Padding="28"><StackPanel>
      <TextBlock Text="BetterGI Pro" FontSize="26" FontWeight="Bold" Foreground="#1F6B4A"/>
      <TextBlock Text=".NET 8 + WPF + WebView2" Margin="0,6,0,0" Foreground="{DynamicResource TextMuted}"/>
    </StackPanel></Border>
    <Button Content="Open Games" Width="260" Height="36" Margin="0,20,0,0" Click="GotoGames_Click"/>
    <Button Content="Open Guide Browser" Width="260" Height="36" Margin="0,10,0,0" Click="GotoBrowser_Click"/>
  </StackPanel></Grid>
</Page>
