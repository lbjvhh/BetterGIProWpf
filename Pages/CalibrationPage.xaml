<Page x:Class="BetterGIProWpf.Pages.CalibrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BgMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="760">
            <TextBlock Text="坐标校准与路径平滑" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="三点标定：视频坐标系 → 游戏坐标系（仿射变换）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="地标 1" Width="60" VerticalAlignment="Center"/>
                        <TextBox x:Name="L1" Width="180" Height="26" Text="960,540,960,540" VerticalContentAlignment="Center"/>
                        <TextBlock Text="视频x,y → 游戏x,y" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="地标 2" Width="60" VerticalAlignment="Center"/>
                        <TextBox x:Name="L2" Width="180" Height="26" Text="480,540,480,540" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="地标 3" Width="60" VerticalAlignment="Center"/>
                        <TextBox x:Name="L3" Width="180" Height="26" Text="960,270,960,270" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="计算变换" Width="100" Margin="0,0,8,0" Click="Calc_Click"/>
                        <TextBlock x:Name="CalibResult" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="路径平滑测试" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="窗口" Width="50" VerticalAlignment="Center"/>
                        <Slider x:Name="SmoothWin" Minimum="1" Maximum="15" Value="5" Width="200"/>
                        <TextBlock x:Name="SmoothWinLabel" Text="5" Width="40" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <TextBox x:Name="PathInput" Height="70" TextWrapping="Wrap" Text="100,100&#x0a;110,108&#x0a;125,115&#x0a;300,320&#x0a;310,318&#x0a;330,325" FontFamily="Consolas" FontSize="12"/>
                    <Button Content="平滑" Width="80" Margin="0,8,0,0" Click="Smooth_Click"/>
                    <TextBlock x:Name="SmoothResult" Margin="0,8,0,0" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="校准目标：路径点误差 &lt; 50px；平滑后执行不出现明显振荡（滑动平均窗口可调）。"
                       Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
