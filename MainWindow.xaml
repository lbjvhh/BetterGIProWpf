<Window x:Class="BetterGIProWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterGI Pro · 融合版" Height="860" Width="1320"
        Background="{DynamicResource BgMain}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" Padding="0,16,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="BetterGI Pro" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextMain}" Margin="16,0,0,2"/>
                <TextBlock DockPanel.Dock="Top" Text="视频识别 → 脚本生成 → 自动执行" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" Margin="16,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Text="v1.0 · 26+ 模块融合" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" Margin="16,0,0,16"/>
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMain}">
                    <ListBoxItem Content="🏠  首页 / 启动" Padding="12,8"/>
                    <ListBoxItem Content="📺  攻略浏览器（2FPS识别）" Padding="12,8"/>
                    <ListBoxItem Content="📚  知识库 / 问答 / 翻译" Padding="12,8"/>
                    <ListBoxItem Content="🎮  操作执行" Padding="12,8"/>
                    <ListBoxItem Content="🛡  AI 队友（双轨）" Padding="12,8"/>
                    <ListBoxItem Content="🎯  策略教练" Padding="12,8"/>
                    <ListBoxItem Content="🔍  识别层 / 问答" Padding="12,8"/>
                    <ListBoxItem Content="📜  脚本仓库 / 自适应" Padding="12,8"/>
                    <ListBoxItem Content="🔁  自动化编排" Padding="12,8"/>
                    <ListBoxItem Content="🧩  插件管理" Padding="12,8"/>
                    <ListBoxItem Content="🕹  游戏管理" Padding="12,8"/>
                    <ListBoxItem Content="📊  仪表盘 / 应急" Padding="12,8"/>
                    <ListBoxItem Content="🎬  高光剪辑" Padding="12,8"/>
                    <ListBoxItem Content="🧠  AI 设置" Padding="12,8"/>
                    <ListBoxItem Content="⚙  通用设置" Padding="12,8"/>
                </ListBox>
            </DockPanel>
        </Border>

        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
