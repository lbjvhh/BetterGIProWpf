<Window x:Class="BetterGIProWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterGI Pro · 融合版" Height="880" Width="1380"
        Background="{DynamicResource BgMain}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧边栏 -->
        <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgSidebar}" Padding="0,16,0,0">
            <DockPanel>
                <!-- 标题区 -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,16">
                    <TextBlock Text="⚡ BetterGI Pro" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="视频识别 → 脚本生成 → 自动执行" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="v1.0 · 26+ 模块融合" FontSize="10"
                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 导航列表 -->
                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMain}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Content="── 核心 ──" Padding="12,6" IsEnabled="False" FontSize="10" Foreground="#888"/>
                    <ListBoxItem Content="🏠  首页 / 启动" Padding="16,10"/>
                    <ListBoxItem Content="📺  攻略浏览器（2FPS）" Padding="16,10"/>
                    <ListBoxItem Content="🎮  操作执行（双轨）" Padding="16,10"/>

                    <ListBoxItem Content="── AI 助手 ──" Padding="12,6" IsEnabled="False" FontSize="10" Foreground="#888"/>
                    <ListBoxItem Content="🤖  AI 队友" Padding="16,10"/>
                    <ListBoxItem Content="🎯  策略教练" Padding="16,10"/>
                    <ListBoxItem Content="🔍  识别层 / 问答" Padding="16,10"/>

                    <ListBoxItem Content="── 工具 ──" Padding="12,6" IsEnabled="False" FontSize="10" Foreground="#888"/>
                    <ListBoxItem Content="📚  知识库 / 翻译" Padding="16,10"/>
                    <ListBoxItem Content="📜  脚本仓库 / 上传" Padding="16,10"/>
                    <ListBoxItem Content="🧩  插件管理" Padding="16,10"/>
                    <ListBoxItem Content="🕹  游戏管理（桌面分身）" Padding="16,10"/>
                    <ListBoxItem Content="🎬  高光剪辑 / 回放" Padding="16,10"/>
                    <ListBoxItem Content="🛠  脚本工坊（独立 App）" Padding="16,10"/>

                    <ListBoxItem Content="── 监控 ──" Padding="12,6" IsEnabled="False" FontSize="10" Foreground="#888"/>
                    <ListBoxItem Content="📊  仪表盘 / 监控" Padding="16,10"/>
                    <ListBoxItem Content="🛡  应急 / 安全停机" Padding="16,10"/>
                    <ListBoxItem Content="⏰  自动化编排" Padding="16,10"/>

                    <ListBoxItem Content="── 设置 ──" Padding="12,6" IsEnabled="False" FontSize="10" Foreground="#888"/>
                    <ListBoxItem Content="🧠  AI 设置" Padding="16,10"/>
                    <ListBoxItem Content="⚙  通用设置" Padding="16,10"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 主内容区 -->
        <Frame Grid.Column="1" Grid.Row="0" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BgSidebar}" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="● 服务状态：" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                <TextBlock x:Name="StatusVision" DockPanel.Dock="Left" Text="vision:--" Foreground="#888" FontSize="11" Margin="8,0,0,0"/>
                <TextBlock x:Name="StatusStream" DockPanel.Dock="Left" Text="stream:--" Foreground="#888" FontSize="11" Margin="8,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="BetterGI Pro v1.0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
