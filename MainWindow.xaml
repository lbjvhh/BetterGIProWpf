<Window x:Class="BetterGIProWpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BetterGI Pro" Height="820" Width="1280" Background="{DynamicResource BgMain}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" Padding="0,16,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="BetterGI Pro" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="WPF Edition" FontSize="11" Margin="16,0,0,16" Foreground="{DynamicResource TextMuted}"/>
        <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" Background="Transparent" BorderThickness="0">
          <ListBoxItem Content="Home" Padding="12,8"/><ListBoxItem Content="Triggers" Padding="12,8"/><ListBoxItem Content="Guide Browser" Padding="12,8"/><ListBoxItem Content="Execute" Padding="12,8"/><ListBoxItem Content="Advanced" Padding="12,8"/><ListBoxItem Content="Agent" Padding="12,8"/><ListBoxItem Content="Companion" Padding="12,8"/><ListBoxItem Content="Coach" Padding="12,8"/><ListBoxItem Content="Media" Padding="12,8"/><ListBoxItem Content="Knowledge" Padding="12,8"/><ListBoxItem Content="Telemetry" Padding="12,8"/><ListBoxItem Content="Scripts" Padding="12,8"/><ListBoxItem Content="Automation" Padding="12,8"/><ListBoxItem Content="Calibration" Padding="12,8"/><ListBoxItem Content="Plugins" Padding="12,8"/><ListBoxItem Content="Recognition" Padding="12,8"/><ListBoxItem Content="Games" Padding="12,8"/><ListBoxItem Content="AI" Padding="12,8"/><ListBoxItem Content="Settings" Padding="12,8"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
  </Grid>
</Window>
